def coefficient_normalized_residue(
    term: C5Term, required_valuation: int
) -> FE:
    if term.valuation == required_valuation:
        return term.unit
    if term.valuation > required_valuation:
        return term.unit.field.zero
    raise ValueError("coefficient lies below the claimed pin")


def gamma_k(case: C5Case, bare: bool = False) -> FE:
    frame = case.frame
    result = frame.field.zero
    i = frame.i(case.k)
    by_j = {term.j: term for term in case.terms}
    for t in range(frame.f1):
        j = i + frame.e1 * t
        if j >= frame.D or j not in by_j:
            continue
        term = by_j[j]
        required = (case.k - j * frame.h) // frame.e1
        if bare:
            residue = term.unit if term.valuation == 0 else frame.field.zero
        else:
            residue = coefficient_normalized_residue(term, required)
        result = result + residue * (frame.eta ** t)
    return result


def direct_normalizer_read(case: C5Case) -> FE:
    frame = case.frame
    i = frame.i(case.k)
    result = frame.field.zero
    for term in case.terms:
        height = frame.e1 * term.valuation + term.j * frame.h
        if height != case.k:
            continue
        if (term.j - i) % frame.e1:
            continue
        t = (term.j - i) // frame.e1
        result = result + term.unit * (frame.eta ** t)
    return result


@dataclass(frozen=True)
class LiftTerm:
    r: int
    coefficient: FE
    x_exponent: int
    pi_exponent: int


def lift_domain(frame: Frame, M: int) -> bool:
    return M > frame.D * frame.h


def lift_terms(frame: Frame, M: int, lambdas: Sequence[int]) -> List[LiftTerm]:
    i = frame.i(M)
    a = frame.a(M)
    terms = []
    for r, scalar in enumerate(lambdas):
        coefficient = frame.field(scalar)
        if coefficient:
            terms.append(
                LiftTerm(
                    r=r,
                    coefficient=coefficient,
                    x_exponent=i + frame.e1 * r,
                    pi_exponent=a - r * frame.h,
                )
            )
    return terms


def lambda_value(frame: Frame, lambdas: Sequence[int]) -> FE:
    result = frame.field.zero
    for r, scalar in enumerate(lambdas):
        result = result + frame.field(scalar) * (frame.eta ** r)
    return result


def lift_residue(frame: Frame, terms: Sequence[LiftTerm]) -> FE:
    result = frame.field.zero
    for term in terms:
        result = result + term.coefficient * (frame.eta ** term.r)
    return result


def actual_xfree_monomial(terms: Sequence[LiftTerm]) -> bool:
    return len(terms) == 1 and terms[0].x_exponent == 0


def predicted_xfree(frame: Frame, M: int, lambdas: Sequence[int]) -> bool:
    nonzero_indices = [r for r, x in enumerate(lambdas) if frame.field(x)]
    digit_in_base = all(r == 0 for r in nonzero_indices)
    return frame.i(M) == 0 and digit_in_base


def c4_data(
    field: Field,
    z: FE,
    ell: int,
    beta: int,
    e: int,
    nu: int,
    support: Sequence[int],
) -> Dict[str, Any]:
    s_min = (ell * beta) % e
    t_min = (ell * beta - s_min) // e
    s_act = s_min + nu * e
    t_def = (s_act - ell * beta) // e
    epsilon = z ** (-t_min)
    raw = z ** t_def
    znu = z ** nu
    p_support = sorted(support)
    h_support = sorted(nu + x for x in support)
    return {
        "s_min": s_min,
        "t_min": t_min,
        "s_act": s_act,
        "t_def": t_def,
        "epsilon": epsilon,
        "raw": raw,
        "znu": znu,
        "p_support": p_support,
        "h_support": h_support,
    }


