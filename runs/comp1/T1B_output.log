def p_trim(poly: Sequence[FE]) -> List[FE]:
    out = list(poly)
    while len(out) > 1 and not out[-1]:
        out.pop()
    return out


def p_add(a: Sequence[FE], b: Sequence[FE]) -> List[FE]:
    field = a[0].field if a else b[0].field
    n = max(len(a), len(b))
    out = []
    for i in range(n):
        av = a[i] if i < len(a) else field.zero
        bv = b[i] if i < len(b) else field.zero
        out.append(av + bv)
    return p_trim(out)


def p_sub(a: Sequence[FE], b: Sequence[FE]) -> List[FE]:
    field = a[0].field if a else b[0].field
    n = max(len(a), len(b))
    out = []
    for i in range(n):
        av = a[i] if i < len(a) else field.zero
        bv = b[i] if i < len(b) else field.zero
        out.append(av - bv)
    return p_trim(out)


def p_mul(a: Sequence[FE], b: Sequence[FE]) -> List[FE]:
    field = a[0].field
    out = [field.zero] * (len(a) + len(b) - 1)
    for i, av in enumerate(a):
        for j, bv in enumerate(b):
            out[i + j] = out[i + j] + av * bv
    return p_trim(out)


def p_divmod(
    numerator: Sequence[FE], denominator: Sequence[FE]
) -> Tuple[List[FE], List[FE]]:
    num = p_trim(numerator)
    den = p_trim(denominator)
    field = den[0].field
    if len(den) == 1 and not den[0]:
        raise ZeroDivisionError("zero polynomial")
    if len(num) < len(den):
        return [field.zero], num

    quotient = [field.zero] * (len(num) - len(den) + 1)
    den_lead_inv = den[-1].inverse()
    while len(num) >= len(den) and not (
        len(num) == 1 and not num[0]
    ):
        shift = len(num) - len(den)
        coeff = num[-1] * den_lead_inv
        quotient[shift] = quotient[shift] + coeff
        subtractor = [field.zero] * shift + [coeff * x for x in den]
        num = p_sub(num, subtractor)
    return p_trim(quotient), p_trim(num)


def p_monic(poly: Sequence[FE]) -> List[FE]:
    poly = p_trim(poly)
    inv = poly[-1].inverse()
    return [x * inv for x in poly]


def monic_polynomials(field: Field, degree: int) -> Iterable[List[FE]]:
    for coeffs in itertools.product(list(field.elements()), repeat=degree):
        yield list(coeffs) + [field.one]


def factor_degrees(poly: Sequence[FE]) -> List[int]:
    poly = p_monic(poly)
    degree = len(poly) - 1
    if degree <= 1:
        return [degree] if degree else []

    field = poly[0].field
    for divisor_degree in range(1, degree // 2 + 1):
        for divisor in monic_polynomials(field, divisor_degree):
            quotient, remainder = p_divmod(poly, divisor)
            if len(remainder) == 1 and not remainder[0]:
                return sorted(
                    factor_degrees(divisor) + factor_degrees(quotient)
                )
    return [degree]


def psi_from_c(field: Field, degree: int, c: Mapping[int, FE]) -> List[FE]:
    coeffs = [field.zero] * (degree + 1)
    coeffs[degree] = field.one
    for t in range(degree):
        coeffs[t] = -c.get(t, field.zero)
    return p_trim(coeffs)


def twisted_poly(poly: Sequence[FE], w: FE) -> List[FE]:
    degree = len(poly) - 1
    return [coeff * (w ** (degree - t)) for t, coeff in enumerate(poly)]


@dataclass(frozen=True)
class Frame:
    name: str
    field: Field
    e1: int
    f1: int
    h: int
    eta: FE
    u2: int

    @property
    def D(self) -> int:
        return self.e1 * self.f1

    @property
    def inv_h(self) -> int:
        return pow(self.h, -1, self.e1)

    def i(self, k: int) -> int:
        return (self.inv_h * k) % self.e1

    def a(self, k: int) -> int:
        return (k - self.i(k) * self.h) // self.e1

    def normalizer_exponents(self, k: int) -> Tuple[int, int]:
        return self.i(k), self.a(k)

    def wrap(self, a: int, b: int) -> int:
        return (self.i(a) + self.i(b)) // self.e1

    def q(self, k: int) -> int:
        return (self.inv_h * k - self.i(k)) // self.e1

    def theta(self, s: int) -> FE:
        return self.eta ** ((s * self.i(self.u2)) // self.e1)


