def stage_theta(
    stage: Stage, mutation: str | None = None
) -> List[FE]:
    frame = stage.frame
    values = []
    for s in range(stage.f2 + 1):
        exponent = (s * frame.i(frame.u2)) // frame.e1
        if mutation == "wrong_sign":
            exponent = -exponent
        elif mutation == "misindexed_telescope":
            exponent = ((s + 1) * frame.i(frame.u2)) // frame.e1
        values.append(frame.eta ** exponent)
    return values


def stage_gamma(
    stage: Stage, mutation: str | None = None
) -> Dict[int, FE]:
    theta = stage_theta(stage, mutation if mutation == "wrong_sign" else None)
    gamma = {}
    for t in range(stage.f2):
        s = stage.f2 - t
        if mutation == "gauge_naive":
            gamma[t] = stage.c[t]
        else:
            gamma[t] = stage.c[t] * theta[s]
    return gamma


def stage_multiplicative(
    stage: Stage, gamma: Mapping[int, FE], theta: Sequence[FE]
) -> Dict[int, FE]:
    return {
        t: gamma[t] / theta[stage.f2 - t]
        for t in range(stage.f2)
    }


def stage_canonical_slots(
    stage: Stage,
    gamma: Mapping[int, FE],
    theta: Sequence[FE],
    inverse_orientation: bool = True,
) -> Dict[int, FE]:
    result = {}
    for t in range(stage.f2):
        s = stage.f2 - t
        orientation = theta[s].inverse() if inverse_orientation else theta[s]
        result[t] = (stage.w ** s) * orientation * gamma[t]
    return result


def canonical_poly_from_slots(stage: Stage, slots: Mapping[int, FE]) -> List[FE]:
    coeffs = [stage.frame.field.zero] * (stage.f2 + 1)
    coeffs[stage.f2] = stage.frame.field.one
    for t, value in slots.items():
        coeffs[t] = -value
    return p_trim(coeffs)


