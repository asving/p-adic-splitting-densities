def pair_ids() -> tuple[str, ...]:
    orbit = tuple(f"S3-orbit-{i:02d}" for i in range(1, 57))
    return orbit + ("PE1-counterinstance",)


def exact_layer_self_test() -> None:
    for e in range(1, 9):
        for h in range(1, 9):
            # Only coprime read parameters are lawful.
            try:
                ell, ell_prime = normalized_bezout(e, h)
            except ValueError:
                raise
            except (ArithmeticError, OSError):
                # pow(..., -1, e) raises ValueError for non-coprime inputs.
                continue
            if ell * h + ell_prime * e != 1:
                raise AssertionError("Bézout self-test failed")
            for beta in range(-20, 21):
                s, u = eq12(beta, e, h)
                if e * u + s * h != beta:
                    raise AssertionError("eq12 self-test failed")

    normalized = normalize_phi1_powers(
        [(2, Fraction(1, 3)), (0, 2), (2, Fraction(2, 3)), (1, 0)]
    )
    expected = (
        NormalizedTerm(0, Fraction(2)),
        NormalizedTerm(2, Fraction(1)),
    )
    if normalized != expected:
        raise AssertionError("formal-U normalization self-test failed")

    allowed = AccessEvent(
        "build formal power",
        "Phi1",
        4,
        0,
        "C_k",
        ("opaque-Phi1-power",),
    )
    forbidden = AccessEvent(
        "inspect constant coefficient",
        "Phi1",
        4,
        0,
        "branch-condition",
        ("expanded-polynomial",),
    )
    if is_forbidden_access(allowed):
        raise AssertionError("opaque access was incorrectly forbidden")
    if not is_forbidden_access(forbidden):
        raise AssertionError("direct non-leading access was not detected")


def emit_result(record: SiteRecord) -> bool:
    green, errors = compare_site_record(record)
    output = {
        "pair": record.pair_id,
        "rung": record.rung,
        "site": record.site_id,
        "site_name": record.site_name,
        "result": "GREEN" if green else "MISMATCH",
        "required_record": record.required_fields,
        "left": None if record.left is None else canonical(record.left),
        "right": None if record.right is None else canonical(record.right),
        "errors": errors,
    }
    print(json.dumps(canonical(output), sort_keys=True, separators=(",", ":")))
    return green


def main() -> int:
    exact_layer_self_test()

    pairs = pair_ids()
    rungs = (2, 3, 4, 5)

    assert len(pairs) == 57
    assert len(HISTORICAL_SITES) == 22
    assert len(pairs) * len(rungs) * len(HISTORICAL_SITES) == 5016

    print("SELFTEST exact-integer-layer: GREEN")
    print(
        "CERTIFICATE DOMAIN: "
        "57 pairs x 4 rungs x 22 historical sites = 5016 records"
    )

    total = 0
    green_count = 0

    for pair_id in pairs:
        for rung in rungs:
            for spec in HISTORICAL_SITES:
                global_text = "; ".join(
                    f"{code}: {detail}" for code, detail in GLOBAL_BLOCKERS
                )
                record = SiteRecord(
                    pair_id=pair_id,
                    rung=rung,
                    site_id=spec.site_id,
                    site_name=spec.name,
                    left=None,
                    right=None,
                    required_fields=spec.required_fields,
                    blocker_code=spec.blocker_code,
                    blocker_detail=f"{spec.blocker_detail}; {global_text}",
                )
                total += 1
                green_count += int(emit_result(record))

    mismatch_count = total - green_count

    print(
        "SUMMARY "
        f"records={total} green={green_count} mismatches={mismatch_count}"
    )
    for code, detail in GLOBAL_BLOCKERS:
        print(f"DETAIL {code}: {detail}")

    print(
        "DETAIL SITE_CLASSIFICATION: the enumerated 22 rows are dependency/"
        "exemption claims; several have no per-pair numerical semantics"
    )
    print(
        "DETAIL REQUIRED_REPAIR: pin a current executable site manifest; "
        "supply all 57 serialized tower pairs through rung 5; supply exact "
        "ring/field arithmetic and canonical-lift/read engines; instrument "
        "Phi1 coefficient accesses before rerunning"
    )

    if mismatch_count == 0:
        print("FINAL VERDICT: CERTIFICATE-GREEN")
        return 0

    print(
        "FINAL VERDICT: MISMATCH "
        f"(details: {mismatch_count}/{total} site records unavailable; "
        "the requested 22-site universe is superseded at HEAD)"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
```

A substantive rerun becomes possible only after pinning a new executable site manifest—either the historical 22 rows, row 23 included, or the 194-hit machine census—and supplying serialized definitions of all 57 pairs through rung 5 plus the instrumented higher-rung runtime.
