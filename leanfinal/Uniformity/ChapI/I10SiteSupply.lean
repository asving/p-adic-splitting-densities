/-! ## §1 The generic operator-algebra layer (uniform in `q`) -/

/-- **[WSS §1] `thetaRatioCleared 1 = 1` at general residue cardinality** — the
general-`q` essence of the keystone's card-2 collapse (`C136c0.s2Site_thetaRatioCleared_one`
proved this via `Rgr = 1` in the 2-element field; the honest content is `a * a⁻¹ = 1` at
the nonzero base read).  General (flagged). -/
theorem thetaRatioCleared_one_of_ne_zero {O : Type} [CommRing O] [IsDomain O]
    [IsDiscreteValuationRing O] {π : O} {F : KeyFrame O π} {H₀ : ℕ} {hpin : F.Pin H₀}
    {r : ℕ} {W : DeepTower.{0, uKt} F H₀ hpin r} {e' f' u' : ℕ}
    (I : FGMNCalculus W e' f' u')
    (h : I.Rgr (e' * u') (I.chainNormBelow r u') ≠ 0) :
    I.thetaRatioCleared 1 = 1 := by
  unfold FGMNCalculus.thetaRatioCleared
  simp only [pow_one, one_mul]
  exact mul_inv_cancel₀ h

section Suppliers

variable {O : Type} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  {Kt : Type uKt} [Field Kt] {E : Type} [Field E]
  {L : Type uL} [Field L] [Algebra Kt L] {n : ℕ}
  {core : ArisingCore (O := O) Kt L n}
  {Aℛ : ChainRealization (O := O) (π := core.π) (F := core.F) (H₀ := core.H₀)
    (hpin := core.hpin) core.T Kt E L}

/-! ## §2 The two supply `Prop`s: rows C0/C1 (bank + wiring) and row C2's exact residue -/

/-- **[WSS §2] The calculus-free ladder-read law** — row C2's exact per-level residue
after the generic discharge (§3): on the realization's OWN exports, (i) the `s = 0`
head (verbatim `RangeCompleteAt`'s first clause), (ii) the D.44 ladder law
`R(n̂(s·q)) = θ(s) · R(n̂(q))^s` at every `s ≥ 1` (for `s` in the cleared window this is
GCW-4's content with the calculus coupling removed; for `s` beyond the window it is
GCW-5's tail), and (iii) the peel tie — the exported peel unit IS the exported read at
the first ladder point.  No FGMN operator occurs in any clause.
NEW STATEMENT (review). -/
structure LadderReadLaw (X : RealizedInput core Aℛ) (hr : 1 < core.r) (j : ℕ) :
    Prop where
  head : towerReadFamily.{0, uG, uKt, uL} X j
      ((Aℛ.normalizer.arenaNormSection0.transport
        (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
          gaugeLatticeEquiv core.r).symm).n 0) =
    ((arenaFamily.{0, uG, uKt, uL} X hr j).theta (useHeightFamily X j) 0 : Kt)
  law : ∀ s : ℕ, 1 ≤ s →
    towerReadFamily.{0, uG, uKt, uL} X j
        ((Aℛ.normalizer.arenaNormSection0.transport
          (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
            gaugeLatticeEquiv core.r).symm).n
          ((s : ℤ) * useHeightFamily X j)) =
      ((arenaFamily.{0, uG, uKt, uL} X hr j).theta (useHeightFamily X j) s : Kt) *
        (towerReadFamily.{0, uG, uKt, uL} X j
          ((Aℛ.normalizer.arenaNormSection0.transport
            (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
              gaugeLatticeEquiv core.r).symm).n (useHeightFamily X j))) ^ s
  tie : ((Aℛ.node.peelUnitFamily j : Ktˣ) : Kt) =
    towerReadFamily.{0, uG, uKt, uL} X j
      ((Aℛ.normalizer.arenaNormSection0.transport
        (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
          gaugeLatticeEquiv core.r).symm).n (useHeightFamily X j))

/-- **[WSS §2] The bank-and-wiring supply** (rows C0/C1): at every deep-live level, a
positive triple, a site calculus on the truncated tower, the four B-1 normalizer
supplies (what the cleared engine consumes — the cleared law itself is NOT demanded, it
is derived in §3), and the own-export GC-13 wiring leg.  This is exactly the data an
L2E-genre per-level operator-bank engine produces (cf. the keystone: `s2SiteMu4Calculus`
+ `s2Site_B1_*` + `s2Four_gc13Wiring`).  NEW STATEMENT (review). -/
def SiteCalculusSupply (X : RealizedInput core Aℛ) : Prop :=
  ∀ j, (hj : DeepLive core.r j) →
    ∃ (e' f' u' : ℕ) (I : FGMNCalculus (core.T.trunc j hj.2.le) e' f' u'),
      0 < f' ∧
      (2 ≤ f' → I.PrevGrade (e' * u')) ∧
      (∀ d, 0 < d → d ≤ f' →
        I.ExactGrade (e' * (d * u')) (I.chainNormBelow j (d * u'))) ∧
      (∀ d, 0 < d → d ≤ f' →
        (I.chainNormBelow j (d * u')).natDegree < (I.keyAt j).natDegree) ∧
      (∀ d, 0 < d → d ≤ f' → I.chainNormBelow j (d * u') ≠ 0) ∧
      IFC3.GC13Wiring
        (Aℛ.normalizer.arenaNormSection0.transport
          (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
            gaugeLatticeEquiv core.r).symm)
        (useHeightFamily X j) (towerReadFamily X j) I
        (Aℛ.receiver.levelHom j)

/-- **[WSS §2] The ladder-read supply** (row C2's residue): the calculus-free
`LadderReadLaw` at every deep-live level.  NEW STATEMENT (review). -/
def LadderReadSupply (X : RealizedInput core Aℛ) : Prop :=
  ∀ j, (hj : DeepLive core.r j) →
    LadderReadLaw.{uG, uKt, uL} X (by rcases hj with ⟨hj3, hjr⟩; omega) j

/-- Vacuity tooth: at depth `r ≤ 3` the bank supply holds vacuously. -/
theorem siteCalculusSupply_of_shallow (X : RealizedInput core Aℛ)
    (hr : core.r ≤ 3) : SiteCalculusSupply.{uG, uKt, uL} X := by
  intro j hj
  rcases hj with ⟨hj3, hjr⟩
  omega

/-- Vacuity tooth: at depth `r ≤ 3` the ladder supply holds vacuously. -/
theorem ladderReadSupply_of_shallow (X : RealizedInput core Aℛ)
    (hr : core.r ≤ 3) : LadderReadSupply.{uG, uKt, uL} X := by
  intro j hj
  rcases hj with ⟨hj3, hjr⟩
  omega

/-! ## §3 ★ The generic reduction: bank + wiring + ladder law ⟹ the full per-level
`WiredSiteSupply` demand, uniform in `q` -/

/-- ★ **[WSS §3] THE PER-LEVEL GENERIC ASSEMBLY** — from the B-1 bank supplies, the
wiring law, and the calculus-free ladder-read law, the FULL per-level content of
`WiredSiteSupply`: the G3 site package (cleared law DERIVED by the landed general-depth
engine) and all three consumer dictionaries (their calculus coupling DERIVED:
`φ(thetaRatioCleared s)` is forced through the cleared power law, `Rgr_ne_zero`, and the
injectivity of the receiver between fields).  No cardinality assumption, no S2 datum, no
numeral — uniform in the residue cardinality. -/
theorem wleSiteExists_of_supplies (X : RealizedInput core Aℛ) {j : ℕ}
    (hj : DeepLive core.r j) {e' f' u' : ℕ} (f_pos : 0 < f')
    (I : FGMNCalculus (core.T.trunc j hj.2.le) e' f' u')
    (hprev : 2 ≤ f' → I.PrevGrade (e' * u'))
    (hnorm : ∀ d, 0 < d → d ≤ f' →
      I.ExactGrade (e' * (d * u')) (I.chainNormBelow j (d * u')))
    (hnormdeg : ∀ d, 0 < d → d ≤ f' →
      (I.chainNormBelow j (d * u')).natDegree < (I.keyAt j).natDegree)
    (hnormz : ∀ d, 0 < d → d ≤ f' → I.chainNormBelow j (d * u') ≠ 0)
    (hwiring : IFC3.GC13Wiring
      (Aℛ.normalizer.arenaNormSection0.transport
        (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
          gaugeLatticeEquiv core.r).symm)
      (useHeightFamily X j) (towerReadFamily X j) I
      (Aℛ.receiver.levelHom j))
    (hlad : LadderReadLaw.{uG, uKt, uL} X (by rcases hj with ⟨hj3, hjr⟩; omega) j) :
    ∃ S : WleClearedLevelExport.{0, uG, uKt, uL} X j hj.2.le,
      ThetaCompatibleAt X (by rcases hj with ⟨hj3, hjr⟩; omega) S ∧
      PeelCompatibleAt X S ∧
      RangeCompleteAt X (by rcases hj with ⟨hj3, hjr⟩; omega) S := by
  -- the receiver is injective (a ring hom between fields)
  have hφinj : Function.Injective (Aℛ.receiver.levelHom j) :=
    (Aℛ.receiver.levelHom j).injective
  -- the base read at s = 1, in normalized form
  have hw1 : towerReadFamily X j
      ((Aℛ.normalizer.arenaNormSection0.transport
        (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
          gaugeLatticeEquiv core.r).symm).n (useHeightFamily X j)) =
      Aℛ.receiver.levelHom j (I.Rgr (e' * u') (I.chainNormBelow j u')) := by
    have h := hwiring.read_norm 1 le_rfl f_pos
    simp only [Nat.cast_one, one_mul] at h
    exact h
  -- the canonical cleared witness is nonzero
  have hw0ne : I.Rgr (e' * u') (I.chainNormBelow j u') ≠ 0 := by
    have h := I.Rgr_ne_zero (e' * (1 * u')) (I.chainNormBelow j (1 * u'))
      (hnorm 1 one_pos f_pos) (hnormdeg 1 one_pos f_pos) (hnormz 1 one_pos f_pos)
    simp only [one_mul] at h
    exact h
  refine ⟨{ e' := e', f' := f', u' := u', f_pos := f_pos, calculus := I,
            cleared := Tower.C136c0.gentow5w_cleared_of_B1 (core.T.trunc j hj.2.le)
              e' f' u' I f_pos hprev hnorm hnormdeg hnormz,
            wiring := hwiring }, ?_, ?_, ?_⟩
  · -- ThetaCompatibleAt: the calculus coupling is derived
    intro s hs1 hsf
    have hr1 : 1 < core.r := by rcases hj with ⟨hj3, hjr⟩; omega
    have hlad' : LadderReadLaw.{uG, uKt, uL} X hr1 j := hlad
    have hsf' : s ≤ f' := hsf
    have hs0 : 0 < s := hs1
    -- the cleared power law at exponent s
    have hkey : I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u')) *
        I.thetaRatioCleared s
        = (I.Rgr (e' * u') (I.chainNormBelow j u')) ^ s := by
      have h := C132sg3.ratio_power_law_cleared (core.T.trunc j hj.2.le) e' f' u' I
        f_pos hprev hnorm hnormdeg hnormz (t := f' - s) (by omega)
      rwa [show f' - (f' - s) = s by omega] at h
    have hRne : I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u')) ≠ 0 :=
      I.Rgr_ne_zero _ _ (hnorm s hs0 hsf') (hnormdeg s hs0 hsf') (hnormz s hs0 hsf')
    have hφRne : Aℛ.receiver.levelHom j
        (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u'))) ≠ 0 :=
      fun h0 => hRne (hφinj (h0.trans (map_zero (Aℛ.receiver.levelHom j)).symm))
    have hw : towerReadFamily X j
        ((Aℛ.normalizer.arenaNormSection0.transport
          (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
            gaugeLatticeEquiv core.r).symm).n ((s : ℤ) * useHeightFamily X j)) =
        Aℛ.receiver.levelHom j
          (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u'))) :=
      hwiring.read_norm s hs1 hsf'
    -- the receiver image of the cleared power law, assembled at TERM level (the
    -- trunc/tower field boundary is defeq but not reducibly so; `rw` cannot cross it)
    have hstep : Aℛ.receiver.levelHom j
          (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u'))) *
        Aℛ.receiver.levelHom j (I.thetaRatioCleared s) =
        (Aℛ.receiver.levelHom j (I.Rgr (e' * u') (I.chainNormBelow j u'))) ^ s :=
      (map_mul (Aℛ.receiver.levelHom j)
        (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u')))
        (I.thetaRatioCleared s)).symm.trans
        ((congrArg (Aℛ.receiver.levelHom j) hkey).trans
          (map_pow (Aℛ.receiver.levelHom j)
            (I.Rgr (e' * u') (I.chainNormBelow j u')) s))
    show ((arenaFamily.{0, uG, uKt, uL} X hr1 j).theta (useHeightFamily X j) s : Kt) *
        Aℛ.receiver.levelHom j (I.thetaRatioCleared s) = 1
    refine mul_right_cancel₀ hφRne ?_
    calc ((arenaFamily.{0, uG, uKt, uL} X hr1 j).theta (useHeightFamily X j) s : Kt) *
          Aℛ.receiver.levelHom j (I.thetaRatioCleared s) *
          Aℛ.receiver.levelHom j
            (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u')))
        = ((arenaFamily.{0, uG, uKt, uL} X hr1 j).theta (useHeightFamily X j) s : Kt) *
            (Aℛ.receiver.levelHom j
              (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u'))) *
             Aℛ.receiver.levelHom j (I.thetaRatioCleared s)) := by ring
      _ = ((arenaFamily.{0, uG, uKt, uL} X hr1 j).theta (useHeightFamily X j) s : Kt) *
            (Aℛ.receiver.levelHom j
              (I.Rgr (e' * u') (I.chainNormBelow j u'))) ^ s := by rw [hstep]
      _ = ((arenaFamily.{0, uG, uKt, uL} X hr1 j).theta (useHeightFamily X j) s : Kt) *
            (towerReadFamily X j
              ((Aℛ.normalizer.arenaNormSection0.transport
                (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
                  gaugeLatticeEquiv core.r).symm).n (useHeightFamily X j))) ^ s := by
              rw [hw1]
      _ = towerReadFamily X j
            ((Aℛ.normalizer.arenaNormSection0.transport
              (show GaugeLattice.{uG} core.r ≃* GaugeLattice0 core.r from
                gaugeLatticeEquiv core.r).symm).n
              ((s : ℤ) * useHeightFamily X j)) := (hlad'.law s hs1).symm
      _ = Aℛ.receiver.levelHom j
            (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u'))) := hw
      _ = 1 * Aℛ.receiver.levelHom j
            (I.Rgr (e' * (s * u')) (I.chainNormBelow j (s * u'))) := (one_mul _).symm
  · -- PeelCompatibleAt: the power law is the cleared engine; only the tie is consumed
    refine ⟨I.Rgr (e' * u') (I.chainNormBelow j u'), hw0ne, ?_, ?_⟩
    · intro t ht
      exact C132sg3.ratio_power_law_cleared (core.T.trunc j hj.2.le) e' f' u' I
        f_pos hprev hnorm hnormdeg hnormz ht
    · rw [hlad.tie]
      exact hw1
  · -- RangeCompleteAt: both clauses are the ladder law + the tie
    constructor
    · exact hlad.head
    · intro s hs
      have hs1 : 1 ≤ s := by omega
      rw [hlad.tie]
      exact hlad.law s hs1

/-- ★ **[WSS §3] THE PER-REALIZATION REDUCTION** — the two supply `Prop`s compile to the
landed `WiredSiteSupply` (USUP §3's minimal `GentowW` boundary), at every arising
realization, uniform in the residue cardinality. -/
theorem wiredSiteSupply_of_supplies (X : RealizedInput core Aℛ)
    (hbank : SiteCalculusSupply.{uG, uKt, uL} X)
    (hlad : LadderReadSupply.{uG, uKt, uL} X) :
    WiredSiteSupply.{uG, uKt, uL} X := by
  intro j hj
  obtain ⟨e', f', u', I, f_pos, hprev, hnorm, hnormdeg, hnormz, hwiring⟩ := hbank j hj
  exact wleSiteExists_of_supplies X hj f_pos I hprev hnorm hnormdeg hnormz hwiring
    (hlad j hj)

/-- Corollary (through USUP's landed one-liner): the two supplies fire the `GentowW`
per-witness exporter. -/
theorem gentowPerWitnessExporter_of_supplies (X : RealizedInput core Aℛ)
    (hbank : SiteCalculusSupply.{uG, uKt, uL} X)
    (hlad : LadderReadSupply.{uG, uKt, uL} X) :
    GentowPerWitnessExporter.{uG, uKt, uL} X :=
  gentowPerWitnessExporter_of_wiredSiteSupply X
    (wiredSiteSupply_of_supplies X hbank hlad)

end Suppliers

/-! ## §4 The universal supply forms and the capstone composition -/

/-- **[WSS §4] The universal bank-and-wiring supply**: rows C0/C1 at EVERY arising
realization of degree `n`.  NEW STATEMENT (review). -/
def UniversalSiteCalculusSupply (n : ℕ) : Prop :=
  ∀ (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (Kt : Type uKt) [Field Kt] (E : Type) [Field E]
    (L : Type uL) [Field L] [Algebra Kt L]
    (core : ArisingCore (O := O) Kt L n)
    (Aℛ : ChainRealization (O := O) (π := core.π) (F := core.F) (H₀ := core.H₀)
      (hpin := core.hpin) core.T Kt E L)
    (X : RealizedInput core Aℛ),
    SiteCalculusSupply.{uG, uKt, uL} X

/-- **[WSS §4] The universal ladder-read supply**: row C2's calculus-free residue at
EVERY arising realization of degree `n`.  NEW STATEMENT (review). -/
def UniversalLadderReadSupply (n : ℕ) : Prop :=
  ∀ (O : Type) [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
    (Kt : Type uKt) [Field Kt] (E : Type) [Field E]
    (L : Type uL) [Field L] [Algebra Kt L]
    (core : ArisingCore (O := O) Kt L n)
    (Aℛ : ChainRealization (O := O) (π := core.π) (F := core.F) (H₀ := core.H₀)
      (hpin := core.hpin) core.T Kt E L)
    (X : RealizedInput core Aℛ),
    LadderReadSupply.{uG, uKt, uL} X

/-- ★ **[WSS §4] THE UNIVERSAL REDUCTION** — the two universal supplies compile to
USUP's `UniversalWiredSiteSupply n`: HALF the capstone `deepTwist` field's remaining
boundary, now at the strictly smaller bank/ladder surface. -/
theorem universalWiredSiteSupply_of_supplies {n : ℕ}
    (hbank : UniversalSiteCalculusSupply.{uG, uKt, uL} n)
    (hlad : UniversalLadderReadSupply.{uG, uKt, uL} n) :
    UniversalWiredSiteSupply.{uG, uKt, uL} n := by
  intro O _ _ _ Kt _ E _ L _ _ core Aℛ X
  exact wiredSiteSupply_of_supplies X (hbank O Kt E L core Aℛ X)
    (hlad O Kt E L core Aℛ X)

/-- ★ **[WSS §4] The capstone `deepTwist` field from THREE named supply `Prop`s** —
USUP's tau supply + this unit's bank and ladder supplies, through
`deepTwistField_of_supplies`.  SUFFICIENT ONLY; the exact boundary remains
`deepTwistField_iff_universalPerWitness`, and per that iff the supplies at general
witnesses ARE the field. -/
theorem deepTwistField_of_bank_supplies {n : ℕ}
    (hv : UniversalTauWordDescentSupply.{uG, uKt, uL} n)
    (hbank : UniversalSiteCalculusSupply.{uG, uKt, uL} n)
    (hlad : UniversalLadderReadSupply.{uG, uKt, uL} n) :
    IFC0.DeepTwistField.{uG, uKt, uL} n :=
  deepTwistField_of_supplies hv (universalWiredSiteSupply_of_supplies hbank hlad)

