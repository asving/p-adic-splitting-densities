variable {O : Type} [CommRing O] [IsDomain O] [IsDiscreteValuationRing O]
  [Finite (ResidueField O)] (h2 : Irreducible (2 : O)) (hq : residueCard O = 2)
variable (L : Type uL) [Field L] [Algebra ((s2DepthFour h2 hq).fld 4) L]
variable [IsAdicComplete (IsLocalRing.maximalIdeal O) O]
variable (w₁ : S2LevelOneThreshold) (w₂ : S2LevelTwoThresholdFour)
  (w₃ : S2LevelThreeThresholdFour) (w₄ : S2LevelFourThresholdFour)
variable {n : ℕ} (F₀ : Polynomial O) (hF₀ : F₀.Monic) (μ : ℕ) (hμ : 1 ≤ μ)
  (hdeg : F₀.natDegree = n) (hblock : n = μ * 16)
  (hcop : IsCoprime (F₀.map (algebraMap O (FractionRing O)))
    ((g16 h2 hq).map (algebraMap O (FractionRing O))))

/-- coherence pin for §1: the generic lemma re-derives the keystone's
`thetaRatioCleared 1 = 1` WITHOUT the card-2 value collapse (nonzeroness of the base
read suffices; it comes from `Rgr_ne_zero` at the landed B-1 supplies). -/
example : (s2SiteMu4Calculus h2 hq).thetaRatioCleared 1 = 1 :=
  thetaRatioCleared_one_of_ne_zero (s2SiteMu4Calculus h2 hq) (by
    have h := (s2SiteMu4Calculus h2 hq).Rgr_ne_zero _ _
      (s2Site_B1_exact_grade_supply h2 hq 1 one_pos le_rfl)
      (s2Site_B1_degree_supply h2 hq 1 one_pos le_rfl)
      (s2Site_B1_nonzero_supply h2 hq 1 one_pos le_rfl)
    simpa using h)

/-- ★ **[WSS §5] The bank-and-wiring supply at EVERY depth-4 keystone witness** — the C1
data repackaged in the new shape: `(e', f', u') = (2, 1, 85)`, the site calculus, the
landed B-1 supplies (the `PrevGrade` leg vacuous at `f' = 1`), and the C0 wiring leg.
Conditionality: exactly the keystone's. -/
theorem s2Four_siteCalculusSupply :
    SiteCalculusSupply.{0, 0, uL}
      (s2FourRealizedInputOf h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock hcop) := by
  intro j hj
  have hj' : 3 ≤ j ∧ j < 4 := hj
  have hj3 : j = 3 := by omega
  subst hj3
  exact ⟨2, 1, 85, s2SiteMu4Calculus h2 hq, one_pos,
    fun hcon => absurd hcon (by norm_num),
    s2Site_B1_exact_grade_supply h2 hq,
    s2Site_B1_degree_supply h2 hq,
    s2Site_B1_nonzero_supply h2 hq,
    s2Four_gc13Wiring h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock hcop
      hj.gaugeLive _ _ _⟩

/-- ★ **[WSS §5] The ladder-read supply at EVERY depth-4 keystone witness** — the
card-2 collapses, now visibly confined to the CALCULUS-FREE residue: the wired read is
`1` on the live range, every theta value and the peel unit are units of the 2-element
terminal field.  This is the nonvacuity tooth of `LadderReadLaw`; the collapse is
exactly what a general residue cardinality does NOT inherit. -/
theorem s2Four_ladderReadSupply :
    LadderReadSupply.{0, 0, uL}
      (s2FourRealizedInputOf h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock hcop) := by
  intro j hj
  have hj' : 3 ≤ j ∧ j < 4 := hj
  have hj3 : j = 3 := by omega
  subst hj3
  refine ⟨?_, ?_, ?_⟩
  · refine (s2Four_towerReadFamily_live h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock
      hcop hj.gaugeLive _).trans (Eq.symm ?_)
    exact c0_eq_one_of_ne_zero (s2R7Fld_card h2 hq 4) (Units.ne_zero _)
  · intro s hs1
    simp only [s2Four_towerReadFamily_live h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock
      hcop hj.gaugeLive, one_pow, mul_one]
    exact Eq.symm (c0_eq_one_of_ne_zero (s2R7Fld_card h2 hq 4) (Units.ne_zero _))
  · rw [s2Four_towerReadFamily_live h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock hcop
      hj.gaugeLive _]
    exact (congrArg Units.val (s2FourUnit_eq_one h2 hq _)).trans Units.val_one

/-- Coherence pin: the two keystone supplies re-derive the landed `WiredSiteSupply`
instance through the NEW generic reduction (the supply route and USUP's direct route
agree on the wired genre). -/
example :
    WiredSiteSupply.{0, 0, uL}
      (s2FourRealizedInputOf h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock hcop) :=
  wiredSiteSupply_of_supplies _
    (s2Four_siteCalculusSupply h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock hcop)
    (s2Four_ladderReadSupply h2 hq L w₁ w₂ w₃ w₄ F₀ hF₀ μ hμ hdeg hblock hcop)

end Wired

