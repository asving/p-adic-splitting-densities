namespace LeanUrat.MovesT

open Polynomial LeanUrat.Moves LeanUrat.MovesC LeanUrat.MovesD

variable {p : ℕ} [Fact p.Prime] {F : Type*} [Field F] [Finite F]
variable {n N m : ℕ} {pol : CanonPolicy p F}

/-- **TV-B3, the single-model core** — pointwise child transfer at a fixed box
pair gives mem transfer at every history (mem is GENERATED by child through
`mem_single`/`mem_snoc`; induction via `History.snoc_induction`, TV-B8). -/
theorem tv_b3_mem_transfer_of_child_transfer (T : TreeModel p F n N m pol)
    (x x' : Box p m)
    (hchild : ∀ (o : Option (History p F)) (ν : Node p F),
      T.child o ν x ↔ T.child o ν x')
    (H : History p F) :
    T.mem (some H) x ↔ T.mem (some H) x' := by
  sorry

/-- **TV-B3 `mem_cyl_of_child_cyl`** — (S-child) ⟹ (S-mem), the blueprint's
tower form verbatim: under the TV-B2 bundle, at every threshold-passing pair
N ≤ N' and every box pair agreeing on the level-<N block (the first n·N
coordinates), membership transfers at EVERY history — the arbitrary-H
determinacy `fiberAt` clause (i)'s backward direction needs (quantifier option
α, TV-B2's R8 flag). -/
theorem mem_cyl_of_child_cyl {N₀ : ℕ}
    (Tat : ∀ N', N₀ ≤ N' → TreeModel p F n N' (n * N') pol)
    (χat : ∀ N', Fin n → Fin (n * N')) (Tr : VTree p F)
    (SI : StableInputs Tat χat Tr)
    (N : ℕ) (hN : Tr.thr n ≤ N)
    (N' : ℕ) (h' : N₀ ≤ N') (hNN' : N ≤ N')
    (H : History p F) (x x' : Box p (n * N'))
    (hagree : ∀ c : Fin (n * N'), (c : ℕ) < n * N → x c = x' c) :
    (Tat N' h').mem (some H) x ↔ (Tat N' h').mem (some H) x' := by
  sorry

end LeanUrat.MovesT
