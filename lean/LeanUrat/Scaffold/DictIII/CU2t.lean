namespace LeanUrat.Scaffold.DictIII

variable {p : ℕ} [Fact p.Prime] {F : Type*} [Field F] [Finite F]

/-- CU-2t decidedness, branch (i): some node at index ≥ 1 selects residual
    multiplicity μ = 1 (the terminal "irreducible read" verdict). -/
def DecIrr (H : EHist p F) : Prop :=
  ∃ k ν g, 1 ≤ k ∧ H.nodes[k]? = some ν ∧ ν.sel = some (g, 1)
  -- `.get?` → `[k]?`: header note

/-- CU-2t decidedness, branch (ii): a length-1 history decided at the root —
    either a₀ = 1 outright, or some semantic datum reads root order 1. -/
def DecHen (f : Polynomial ℤ_[p]) (H : EHist p F) : Prop :=
  H.nodes.length = 1 ∧
    (H.a0 = 1 ∨
      ∃ D : GMNData f (Theta H), D.rootOrder = 1)

/-- Unit III-S1c (BP_III §1.9, CUC §9.2): if `φ²` does not divide the mod-p
    reduction of `f`, then any `φ`-power dividing that reduction has exponent
    `j₀ ≤ 1`.  The `¬φ² ∣ f̄` premise is EXPLICIT (REV2 finding 16 — no bare
    characteristic-zero discriminant claim; III-S1b supplies it from the
    discriminant p-unit premise).  `Polynomial.map PadicInt.toZMod f` renders
    the display's mod-p reduction: header note (III-S1c). -/
theorem j0_le_one (f : Polynomial ℤ_[p]) (hf : f.Monic)
    (φ : Polynomial (ZMod p)) (hφ : Irreducible φ)
    (hsq : ¬φ ^ 2 ∣ Polynomial.map PadicInt.toZMod f)
    (j₀ : ℕ)
    (hj₀ : φ ^ j₀ ∣ Polynomial.map PadicInt.toZMod f) :
    j₀ ≤ 1 := by
  by_contra h
  exact hsq ((pow_dvd_pow φ (by omega : 2 ≤ j₀)).trans hj₀)

/-! ## Unit III-S5a — probe of the installed Mathlib Hensel declaration

MECH probe (BP_III §2 row III-S5a; src CUC §9.3 (ii)): record the fully
qualified name and type of the Hensel declaration actually installed in the
pinned Mathlib (`v4.31.0`), without assuming `Polynomial.hensels_lemma`
exists.  Findings, anchored by the `#check`s and the `run_cmd` below:

* THE declaration is **`hensels_lemma`** — TOP-LEVEL, no namespace.
  `Polynomial.hensels_lemma` does NOT exist in this pin (the `Hensel`
  namespace of its file closes before the theorem; machine-checked by the
  `run_cmd` environment probe below).  Location:
  `Mathlib/NumberTheory/Padics/Hensel.lean` (line 458 in the pin).
  Type as printed by `#check @hensels_lemma`:

  ```
  ∀ {p : ℕ} [inst : Fact (Nat.Prime p)] {R : Type u_1} [inst_1 : CommSemiring R]
    [inst_2 : Algebra R ℤ_[p]] {F : Polynomial R} {a : ℤ_[p]},
    ‖(Polynomial.aeval a) F‖ < ‖(Polynomial.aeval a) (Polynomial.derivative F)‖ ^ 2 →
      ∃ z, (Polynomial.aeval z) F = 0 ∧
        ‖z - a‖ < ‖(Polynomial.aeval a) (Polynomial.derivative F)‖ ∧
        ‖(Polynomial.aeval z) (Polynomial.derivative F)‖
          = ‖(Polynomial.aeval a) (Polynomial.derivative F)‖ ∧
        ∀ (z' : ℤ_[p]), (Polynomial.aeval z') F = 0 →
          ‖z' - a‖ < ‖(Polynomial.aeval a) (Polynomial.derivative F)‖ → z' = z
  ```

  I.e. the NEWTON ROOT-LIFTING form over `ℤ_[p]` (norm condition
  `‖F(a)‖ < ‖F′(a)‖²` ⇒ unique nearby root), NOT a factorization lift.

* Companion class-level forms (`Mathlib/RingTheory/Henselian.lean`):
  `HenselianRing : (R : Type u_1) → [inst : CommRing R] → Ideal R → Prop` and
  `HenselianLocalRing : (R : Type u_1) → [CommRing R] → Prop`, whose field
  `is_henselian` is again SIMPLE-ROOT lifting (monic `f`, root of `f` mod the
  (maximal) ideal with unit derivative, lifts to a root of `f`).  The only
  instance route in the pin is `IsAdicComplete.henselianRing`; no
  `HenselianLocalRing ℤ_[p]` instance is pre-declared anywhere in the pin.

* NEGATIVE finding, load-bearing for III-S5c: the pinned Mathlib has NO
  monic-coprime-FACTORIZATION-lifting Hensel (the `Lit3Hensel` shape of
  BP_III §1.3 / III-H9).  Hence III-S5c must consume the NAMED literature
  row `Lit3Hensel` (structure hypothesis, per the [M]-row discipline), not a
  Mathlib declaration. -/

section IIIS5aProbe

#check @hensels_lemma            -- top-level FQN; type displayed above
#check @HenselianRing            -- class, ideal-relative simple-root form
#check @HenselianLocalRing       -- class, maximal-ideal simple-root form
#check @HenselianLocalRing.is_henselian
#check @IsAdicComplete.henselianRing

-- info-anchor: the environment probe backing the two name claims above.
open Lean Elab Command in
run_cmd do
  let env ← getEnv
  unless env.contains `hensels_lemma do
    throwError "III-S5a probe failed: `hensels_lemma` not found"
  if env.contains `Polynomial.hensels_lemma then
    throwError "III-S5a probe failed: `Polynomial.hensels_lemma` unexpectedly exists"

end IIIS5aProbe

